enum ERelationGrade { Low, High }

class TRelationValue {
    int Amount = 0;
    query int Total() { return @self.Amount; }
}

GameEntity TRelationActor {
    int Value = 1;
    Resource Effort = 3;
}

GameEntity TRelationObject {
    int Value = 0;
}

relation bool Seen for TRelationActor(TRelationActor Source);
relation TRelationValue Detail for TRelationActor(TRelationObject Source);
relation ERelationGrade Grade for TRelationActor(TRelationActor Source);
relation Position Origin for TRelationActor(TRelationActor Source);
relation string Label for TRelationActor(TRelationActor Source);

event int SeenBonus for TRelationActor(TRelationActor Source);

feature Observant {
    on SeenBonus {
        if (Seen.has(@self, Source)) { return 1; }
        return 0;
    }
}

activity void RememberDetail for TRelationActor(TRelationObject Target) {
    let Delay = seconds(5);
    choose int Amount from [1, 2];
    Detail.set(@self, Target, { Amount = Amount; }, Delay);
    let Copy = Detail.get(@self, Target, { Amount = 0; });
    @self.Value = Copy.Total();
}

action Remember for TRelationActor {
    cost @self.Effort = 1;
    let Delay = minutes(10);
    choose TRelationActor Target where !Seen.has(Target, @self);
    Seen.set(Target, @self, true, Delay);
    Seen.set(@self, Target, false);
    require Seen.get(Target, @self, false);
    Grade.set(@self, Target, High, seconds(0));
    require Grade.get(@self, Target, Low) == Low;
    Origin.set(@self, Target, position(@self));
    let Previous = Origin.get(@self, Target, Position { X = 1; Y = 2; });
    @self.Value = Previous.X;
    Label.set(@self, Target, "seen");
    Seen.erase(@self, Target);
}

trigger bool RelationOpening(bool Pending, TRelationActor Target);

reaction Clear for TRelationActor on RelationOpening {
    Seen.erase(Target, @self);
    return Pending;
}
