{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "$defs": {
        "pf2e_base": {
            "type": "object",
            "required": ["type", "name"],
            "properties": {
                "type": { "type": "string" },
                "name": { "type": "string" }
            }
        },

        "pf2e_armor_core": {
            "type": "object",
            "properties": {
                "armor_class_bonus": { "type": "integer" },
                "dexterity_cap": { "type": "integer" },
                "category": {
                    "type": "string",
                    "enum": ["Unarmored", "Light", "Medium", "Heavy"]
                },
                "material": { "type": "string" }
            },
            "required": ["armor_class_bonus", "dexterity_cap", "category", "material"],
            "additionalProperties": false
        },

        "pf2e_armor": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                {
                    "type": "object",
                    "properties": {
                        "type": { "const": "pf2e_armor" },
                        "pf2e_armor": { "$ref": "#/$defs/pf2e_armor_core" }
                    },
                    "required": ["pf2e_armor"]
                }
            ]
        },

        "pf2e_material_core": {
            "type": "object",
            "properties": {
                "hardness": { "type": "integer" }
            },
            "required": ["hardness"],
            "additionalProperties": false
        },

        "pf2e_material": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                {
                    "type": "object",
                    "properties": {
                        "type": { "const": "pf2e_material" },
                        "pf2e_material": { "$ref": "#/$defs/pf2e_material_core" }
                    },
                    "required": ["pf2e_material"]
                }
            ]
        },

        "pf2e_weapon_core": {
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "base_dice_size": { "type": "integer" },
                "damage_type": {
                    "type": "string",
                    "enum": ["Bludgeoning", "Piercing", "Slashing", "Fire"]
                },
                "category": {
                    "type": "string",
                    "enum": ["Unarmed", "Simple", "Martial"]
                },
                "reach": {
                    "type": "integer",
                    "default": 1
                },
                "traits": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "type": "string",
                                "enum": [
                                    "Agile", "Finesse", "Nonlethal", "Fatal",
                                    "Deadly", "Versatile", "Thrown", "TwoHand"
                                ]
                            },
                            {
                                "type": "object",
                                "minProperties": 1,
                                "maxProperties": 1
                            }
                        ]
                    },
                    "default": []
                }
            },
            "required": ["name", "base_dice_size", "damage_type", "category"],
            "additionalProperties": false
        },

        "pf2e_weapon": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                {
                    "type": "object",
                    "properties": {
                        "type": { "const": "pf2e_weapon" },
                        "pf2e_weapon": { "$ref": "#/$defs/pf2e_weapon_core" }
                    },
                    "required": ["pf2e_weapon"]
                }
            ]
        },

        "pf2e_race_core": {
            "type": "object",
            "properties": { "hitpoints": { "type": "integer" } },
            "required": ["hitpoints"],
            "additionalProperties": false
        },

        "pf2e_race": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                {
                    "type": "object",
                    "properties": {
                        "type": { "const": "pf2e_race" },
                        "pf2e_race": { "$ref": "#/$defs/pf2e_race_core" }
                    },
                    "required": ["pf2e_race"]
                }
            ]
        },

        "pf2e_class_core": {
            "type": "object",
            "properties": { "hitpoints": { "type": "integer" } },
            "required": ["hitpoints"],
            "additionalProperties": false
        },

        "pf2e_class": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                {
                    "type": "object",
                    "properties": {
                        "type": { "const": "pf2e_class" },
                        "pf2e_class": { "$ref": "#/$defs/pf2e_class_core" }
                    },
                    "required": ["pf2e_class"]
                }
            ]
        },

        "pf2e_ability_score_core": {
            "type": "object",
            "properties": {
                "value": { "type": "integer" }
            },
            "required": ["value"],
            "additionalProperties": false
        },

        "pf2e_ability_scores_core": {
            "type": "object",
            "properties": {
                "strength": { "$ref": "#/$defs/pf2e_ability_score_core" },
                "dexterity": { "$ref": "#/$defs/pf2e_ability_score_core" },
                "constitution": { "$ref": "#/$defs/pf2e_ability_score_core" },
                "intelligence": { "$ref": "#/$defs/pf2e_ability_score_core" },
                "wisdom": { "$ref": "#/$defs/pf2e_ability_score_core" },
                "charisma": { "$ref": "#/$defs/pf2e_ability_score_core" }
            },
            "required": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"],
            "additionalProperties": false
        },

        "pf2e_ability_scores": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                {
                    "type": "object",
                    "properties": {
                        "type": { "const": "pf2e_ability_scores" },
                        "pf2e_ability_scores": { "$ref": "#/$defs/pf2e_ability_scores_core" }
                    },
                    "required": ["pf2e_ability_scores"]
                }
            ]
        },

        "pf2e_creature_data_core": {
            "type": "object",
            "properties": {
                "level": { "type": "integer" },
                "size": {
                    "type": "string",
                    "enum": ["Tiny", "Small", "Medium", "Large", "Huge", "Gargantuan"]
                },
                "race": { "type": "string" },
                "class": { "type": "string" },
                "characteristic": {
                    "oneOf": [
                        { "type": "string" },
                        { "$ref": "#/$defs/pf2e_ability_scores_core" }
                    ]
                },
                "movement": {
                    "type": "integer",
                    "default": 0
                },
                "hitpoints": {
                    "type": "object",
                    "properties": {
                        "current_value": { "type": "integer" },
                        "max_value": { "type": "integer" }
                    },
                    "required": ["current_value", "max_value"],
                    "additionalProperties": false
                },
                "armor": { "type": "string" },
                "weapons": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "oneOf": [
                            { "type": "string" },
                            { "$ref": "#/$defs/pf2e_weapon" }
                        ]
                    }
                },
                "natural_weapons": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "oneOf": [
                            { "type": "string" },
                            { "$ref": "#/$defs/pf2e_weapon" }
                        ]
                    }
                },
                "conditions": {
                    "type": "array",
                    "default": [],
                    "items": { "$ref": "#/$defs/pf2e_condition" }
                },
                "immunities": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "string",
                        "enum": ["Bludgeoning", "Piercing", "Slashing", "Fire"]
                    }
                },
                "resistances": {
                    "type": "object",
                    "default": {},
                    "propertyNames": {
                        "enum": ["Bludgeoning", "Piercing", "Slashing", "Fire"]
                    },
                    "additionalProperties": { "type": "integer" }
                },
                "vulnerabilities": {
                    "type": "object",
                    "default": {},
                    "propertyNames": {
                        "enum": ["Bludgeoning", "Piercing", "Slashing", "Fire"]
                    },
                    "additionalProperties": { "type": "integer" }
                },
                "actions": {
                    "type": "integer",
                    "default": 0
                },
                "reactions": {
                    "type": "integer",
                    "default": 0
                },
                "hands": {
                    "type": "integer",
                    "default": 0
                },
                "spell_slots": {
                    "type": "object",
                    "default": {},
                    "propertyNames": {
                        "enum": [
                            "Rank1", "Rank2", "Rank3", "Rank4", "Rank5",
                            "Rank6", "Rank7", "Rank8", "Rank9", "Rank10"
                        ]
                    },
                    "additionalProperties": { "type": "integer" }
                }
            },
            "required": ["level", "size", "race", "class", "characteristic", "armor"],
            "additionalProperties": false
        },

        "pf2e_condition": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": ["Prone"]
                },
                {
                    "type": "object",
                    "properties": {
                        "Frightened": { "type": "integer" },
                        "MultipleAttackPenalty": { "type": "integer" }
                    },
                    "minProperties": 1,
                    "maxProperties": 1,
                    "additionalProperties": false
                }
            ]
        },

        "pf2e_creature_data": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                {
                    "type": "object",
                    "properties": {
                        "type": { "const": "pf2e_creature_data" },
                        "pf2e_creature_data": { "$ref": "#/$defs/pf2e_creature_data_core" }
                    },
                    "required": ["pf2e_creature_data"]
                }
            ]
        },

        "pf2e_creature_characteristics": {
            "type": "object",
            "properties": {
                "Strength": { "type": "integer" },
                "Dexterity": { "type": "integer" },
                "Constitution": { "type": "integer" },
                "Intelligence": { "type": "integer" },
                "Wisdom": { "type": "integer" },
                "Charisma": { "type": "integer" }
            },
            "required": [
                "Strength",
                "Dexterity",
                "Constitution",
                "Intelligence",
                "Wisdom",
                "Charisma"
            ]
        },

        "pf2e_proficiency_bonus": {
            "oneOf": [
                { "type": "integer" },
                {
                    "type": "string",
                    "enum": [
                        "untrained",
                        "trained",
                        "expert",
                        "master",
                        "legendary"
                    ]
                }
            ]
        },

        "pf2e_proficiency": {
            "type": "object",
            "properties": {
                "armor_category": {
                    "type": "object",
                    "properties": {
                        "Heavy": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Medium": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Light": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Unarmored": { "$ref": "#/$defs/pf2e_proficiency_bonus" }
                    },
                    "additionalProperties": false
                },
                "weapon_category": {
                    "type": "object",
                    "properties": {
                        "Unarmed": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Simple": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Martial": { "$ref": "#/$defs/pf2e_proficiency_bonus" }
                    },
                    "additionalProperties": false
                },
                "Perception": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                "savethrow": {
                    "type": "object",
                    "properties": {
                        "Fortitude": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Reflex": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Will": { "$ref": "#/$defs/pf2e_proficiency_bonus" }
                    },
                    "additionalProperties": false
                },
                "skill": {
                    "type": "object",
                    "properties": {
                        "Acrobatics": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Arcana": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Athletics": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Crafting": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Deception": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Diplomacy": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Intimidation": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Medicine": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Nature": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Occultism": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Performance": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Religion": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Society": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Stealth": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Survival": { "$ref": "#/$defs/pf2e_proficiency_bonus" },
                        "Thievery": { "$ref": "#/$defs/pf2e_proficiency_bonus" }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },

        "pf2e_creature_core": {
            "type": "object",
            "properties": {
                "creature_data": { "$ref": "#/$defs/pf2e_creature_data_core" },
                "proficiency": { "$ref": "#/$defs/pf2e_proficiency" },
                "actions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "feats": {
                    "type": "array",
                    "default": [],
                    "items": { "$ref": "#/$defs/pf2e_creature_feat" }
                }
            },
            "required": [
                "creature_data"
            ],
            "additionalProperties": false
        },

        "pf2e_creature_feat": {
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "block": {
                    "oneOf": [
                        { "type": "string" },
                        { "type": "array", "items": { "type": "string" } }
                    ]
                },
                "pipeline": { "type": "array", "items": {} }
            },
            "required": ["name", "block", "pipeline"],
            "additionalProperties": false
        },

        "pf2e_creature": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                { 
                    "type": "object",
                    "properties": {
                        "type": { "const": "pf2e_creature" },
                        "pf2e_creature": { "$ref": "#/$defs/pf2e_creature_core" }
                    },
                    "required": ["pf2e_creature"]
                }
            ]
        },

        "pf2e_action_data": {
            "type": "object",
            "properties": {
                "variables": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "properties": { "type": { "type": "string" } },
                        "required": ["type"]
                    }
                },
                "pipeline": {
                    "type": "array",
                    "items": {}
                }
            }
        },

        "pf2e_action_core": {
            "type": "object",
            "properties": {
                "type": { "const": "pf2e_action" },
                "pf2e_action": { "$ref": "#/$defs/pf2e_action_data" }
            }
        },

        "pf2e_action": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                { "$ref": "#/$defs/pf2e_action_core" }
            ]
        },

        "pf2e_battle_map_core": {
            "type": "object",
            "properties": {
                "type": { "const": "pf2e_battle_map" },
                "pf2e_battle_map": {
                    "type": "object",
                    "properties": {
                        "x_size": { "type": "integer" },
                        "y_size": { "type": "integer" }
                    }
                }
            }
        },

        "pf2e_battle_map": {
            "allOf": [
                { "$ref": "#/$defs/pf2e_base" },
                { "$ref": "#/$defs/pf2e_battle_map_core" }
            ]
        }
    },

    "$ref": "#/$defs/pf2e_base"
}
