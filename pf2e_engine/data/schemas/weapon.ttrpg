import "damage.ttrpg";
import "dice.ttrpg";

enum EWeaponCategory {
    Unarmed,
    Simple,
    Martial,
}

variant TWeaponTrait {
    Agile;
    Finesse;
    Nonlethal;
    Fatal     { EDieSize Die; }
    Deadly    { EDieSize Die; }
    Versatile { EDamageType Type; }
    Thrown    { int RangeFeet; }
    TwoHand   { EDieSize Die; }
}

class TWeapon {
    string Name;
    int BaseDiceSize;
    EDamageType DamageType;
    EWeaponCategory Category;
    int Reach = 1;
    set<TWeaponTrait> Traits;
}
