import "armor.ttrpg";
import "weapon.ttrpg";
import "creature_parts.ttrpg";
import "condition.ttrpg";
import "damage.ttrpg";
import "hitpoints.ttrpg";
import "proficiency.ttrpg";
import "statistic_baseline.ttrpg";
import "check_modifiers.ttrpg";
import "statistics.ttrpg";
import "lore.ttrpg";
import "creature_description.ttrpg";

enum ECreatureSize {
    Tiny,
    Small,
    Medium,
    Large,
    Huge,
    Gargantuan,
}

enum ESpellSlotRank {
    Rank1,
    Rank2,
    Rank3,
    Rank4,
    Rank5,
    Rank6,
    Rank7,
    Rank8,
    Rank9,
    Rank10,
}

GameEntity TCreature {
    string Name;
    set<ECreatureTrait> Traits;
    collection<TLanguage> Languages;
    collection<TSense> Senses;
    int Level;
    ECreatureSize Size;
    TRace Race;
    TClass Class;
    TAbilityScores Characteristic;
    TProficiency Proficiency;
    TStatisticBaseline PerceptionBaseline;
    map<ESavethrow, TStatisticBaseline> SaveBaselines;
    map<ESkill, TStatisticBaseline> SkillBaselines;
    TClassDCProfile ClassDcProfile;
    collection<TLoreSkill> LoreSkills;
    int Movement = 0;
    THitPoints Hitpoints = THitPoints {
        Maximum = Statistic {
            Base = @self.Race.Hitpoints + @self.Level * (@self.Class.Hitpoints + @self.Characteristic.Constitution.Modifier);
        };
    };
    TArmor Armor;
    TStatisticBaseline ArmorClassBaseline;
    collection<TWeapon> Weapons;
    collection<TWeapon> NaturalWeapons;
    collection<Feature> Features;
    set<TCondition> Conditions;
    set<EDamageType> Immunities;
    map<EDamageType, int> Resistances;
    map<EDamageType, int> Vulnerabilities;
    int AttacksMade = 0;
    Resource Actions = 0;
    Resource Reactions = 0;
    Resource Flourishes = 1;
    Resource Hands = 0;
    map<ESpellSlotRank, Resource> SpellSlots;

    query bool IsAlive() {
        return @self.Hitpoints.Current > 0;
    }

    query int SpeedFeet() {
        return @self.Movement * 5;
    }

    query TAbilityScore GetCharacteristic(ECharacteristic Name) {
        if (Name == Strength) {
            return @self.Characteristic.Strength;
        }
        if (Name == Dexterity) {
            return @self.Characteristic.Dexterity;
        }
        if (Name == Constitution) {
            return @self.Characteristic.Constitution;
        }
        if (Name == Intelligence) {
            return @self.Characteristic.Intelligence;
        }
        if (Name == Wisdom) {
            return @self.Characteristic.Wisdom;
        }
        require Name == Charisma;
        return @self.Characteristic.Charisma;
    }

    query int ArmorProficiency(EArmorCategory Category) {
        return @self.Proficiency.ArmorBonus(Category, @self.Level);
    }

    query int WeaponProficiency(EWeaponCategory Category) {
        return @self.Proficiency.WeaponBonus(Category, @self.Level);
    }

    query int SaveProficiency(ESavethrow Save) {
        return @self.Proficiency.SaveBonus(Save, @self.Level);
    }

    query int SkillProficiency(ESkill Skill) {
        return @self.Proficiency.SkillBonus(Skill, @self.Level);
    }

    query int PerceptionProficiency() {
        return @self.Proficiency.PerceptionBonus(@self.Level);
    }

    query int PerceptionBase() {
        if (@self.PerceptionBaseline.IsFixed) {
            return @self.PerceptionBaseline.Value;
        }
        return @self.GetCharacteristic(TStatisticRules {}.PerceptionAttribute()).Modifier
            + @self.PerceptionProficiency();
    }

    query int SaveBase(ESavethrow Save) {
        let Baseline = @self.SaveBaselines.get(Save, TStatisticBaseline {});
        if (Baseline.IsFixed) {
            return Baseline.Value;
        }
        return @self.GetCharacteristic(TStatisticRules {}.SaveAttribute(Save)).Modifier
            + @self.SaveProficiency(Save);
    }

    query int SkillBase(ESkill Skill) {
        let Baseline = @self.SkillBaselines.get(Skill, TStatisticBaseline {});
        if (Baseline.IsFixed) {
            return Baseline.Value;
        }
        return @self.GetCharacteristic(TStatisticRules {}.SkillAttribute(Skill)).Modifier
            + @self.SkillProficiency(Skill);
    }

    query int LoreBase(TLoreSkill Lore) {
        return Lore.Base(@self.Level, @self.Characteristic.Intelligence.Modifier);
    }

    query bool HasClassDC() {
        return @self.ClassDcProfile.Enabled;
    }

    query int ClassDCBase() {
        return @self.ClassDcProfile.Base(@self.Level,
            @self.GetCharacteristic(@self.ClassDcProfile.KeyAttribute).Modifier);
    }

    query TCheckModifiers CheckConditionModifiers() {
        return TCheckModifiers { StatusPenalty = @self.ConditionPenalty(); };
    }

    query int PerceptionBonusWithModifiers(TCheckModifiers Extra) {
        return @self.PerceptionBase() + @self.CheckConditionModifiers().Merge(Extra).Total();
    }

    query int PerceptionBonus() {
        return @self.PerceptionBonusWithModifiers(TCheckModifiers {});
    }

    query int InitiativeBonusWithModifiers(TCheckModifiers Extra) {
        return @self.PerceptionBonusWithModifiers(Extra);
    }

    query int InitiativeBonus() {
        return @self.InitiativeBonusWithModifiers(TCheckModifiers {});
    }

    query int SaveBonusWithModifiers(ESavethrow Save, TCheckModifiers Extra) {
        return @self.SaveBase(Save) + @self.CheckConditionModifiers().Merge(Extra).Total();
    }

    query int SaveBonus(ESavethrow Save) {
        return @self.SaveBonusWithModifiers(Save, TCheckModifiers {});
    }

    query int SkillBonusWithModifiers(ESkill Skill, TCheckModifiers Extra) {
        return @self.SkillBase(Skill) + @self.CheckConditionModifiers().Merge(Extra).Total();
    }

    query int SkillBonus(ESkill Skill) {
        return @self.SkillBonusWithModifiers(Skill, TCheckModifiers {});
    }

    query int LoreBonusWithModifiers(TLoreSkill Lore, TCheckModifiers Extra) {
        return @self.LoreBase(Lore) + @self.CheckConditionModifiers().Merge(Extra).Total();
    }

    query int LoreBonus(TLoreSkill Lore) {
        return @self.LoreBonusWithModifiers(Lore, TCheckModifiers {});
    }

    query int ClassDCWithModifiers(TCheckModifiers Extra) {
        return @self.ClassDCBase() + @self.CheckConditionModifiers().Merge(Extra).Total();
    }

    query int ClassDC() {
        return @self.ClassDCWithModifiers(TCheckModifiers {});
    }

    query int PerceptionDCWithModifiers(TCheckModifiers Extra) {
        return 10 + @self.PerceptionBonusWithModifiers(Extra);
    }

    query int PerceptionDC() {
        return @self.PerceptionDCWithModifiers(TCheckModifiers {});
    }

    query int SaveDCWithModifiers(ESavethrow Save, TCheckModifiers Extra) {
        return 10 + @self.SaveBonusWithModifiers(Save, Extra);
    }

    query int SaveDC(ESavethrow Save) {
        return @self.SaveDCWithModifiers(Save, TCheckModifiers {});
    }

    query int SkillDCWithModifiers(ESkill Skill, TCheckModifiers Extra) {
        return 10 + @self.SkillBonusWithModifiers(Skill, Extra);
    }

    query int SkillDC(ESkill Skill) {
        return @self.SkillDCWithModifiers(Skill, TCheckModifiers {});
    }

    query int LoreDCWithModifiers(TLoreSkill Lore, TCheckModifiers Extra) {
        return 10 + @self.LoreBonusWithModifiers(Lore, Extra);
    }

    query int LoreDC(TLoreSkill Lore) {
        return @self.LoreDCWithModifiers(Lore, TCheckModifiers {});
    }

    query int ConditionPenalty() {
        return @self.Conditions.get(Frightened, { Value = 0; }).Value;
    }

    query int AttackConditionPenalty() {
        let Penalty = @self.ConditionPenalty();
        if (@self.Conditions.has(Prone)) {
            Penalty += 2;
        }
        return Penalty;
    }

    query int ArmorClass() {
        let Value = @self.ArmorClassBaseline.Value;
        if (!@self.ArmorClassBaseline.IsFixed) {
            Value = 10 + @self.Armor.ArmorClassBonus
                + min(@self.Armor.DexterityCap, @self.Characteristic.Dexterity.Modifier)
                + @self.ArmorProficiency(@self.Armor.Category);
        }
        Value -= @self.ConditionPenalty();
        if (@self.Conditions.has(Prone)) {
            Value -= 2;
        }
        return Value;
    }

    query int AttackBonus(TWeapon Weapon) {
        if (Weapon.AttackBonusBaseline.IsFixed) {
            return Weapon.AttackBonusBaseline.Value - @self.AttackConditionPenalty();
        }
        let Modifier = @self.Characteristic.Strength.Modifier;
        if (Weapon.Traits.has(Finesse)) {
            Modifier = max(Modifier, @self.Characteristic.Dexterity.Modifier);
        }
        return Modifier + @self.WeaponProficiency(Weapon.Category) - @self.AttackConditionPenalty();
    }

    query int AttackCountPenalty(bool Agile) {
        require @self.AttacksMade >= 0;
        let Step = 5;
        if (Agile) {
            Step = 4;
        }
        return min(@self.AttacksMade, 2) * Step;
    }

    query int MultipleAttackPenalty(TWeapon Weapon) {
        return @self.AttackCountPenalty(Weapon.Traits.has(Agile));
    }

    query int DamageModifier(TWeapon Weapon) {
        if (Weapon.DamageModifierBaseline.IsFixed) {
            return Weapon.DamageModifierBaseline.Value;
        }
        return @self.Characteristic.Strength.Modifier;
    }

    query int DamageAmount(EDamageType Type, int Amount) {
        require Amount >= 0;
        if (Amount == 0 || @self.Immunities.has(Type)) {
            return 0;
        }
        let Weakness = @self.Vulnerabilities.get(Type, 0);
        let Resistance = @self.Resistances.get(Type, 0);
        return max(0, Amount + Weakness - Resistance);
    }

    query int MaxWeaponReach() {
        let Reach = 0;
        for Weapon in @self.Weapons {
            Reach = max(Reach, Weapon.Reach);
        }
        for Weapon in @self.NaturalWeapons {
            Reach = max(Reach, Weapon.Reach);
        }
        return Reach;
    }

    method void RecordAttack(int Count) {
        require Count > 0;
        require @self.AttacksMade >= 0;
        @self.AttacksMade += Count;
    }

    method void ResetAttacks() {
        @self.AttacksMade = 0;
    }

    method void BeginRound() {
        @self.Flourishes.SetCount(1);
    }

    method void BeginTurn() {
        @self.ResetAttacks();
        @self.Actions.SetCount(3);
        @self.Reactions.SetCount(1);
    }

    method void EndTurn() {
        @self.Actions.SetCount(0);
        @self.ResetAttacks();
    }

    method TDamageResult ReceiveDamage(EDamageType Type, int Amount) {
        return @self.Hitpoints.DealDamage(@self.DamageAmount(Type, Amount));
    }

    grant @self.Features;
    grant @self.Race;
    grant @self.Class;
    grant @self.Weapons;
    grant @self.NaturalWeapons;
}
