import "armor.ttrpg";
import "weapon.ttrpg";
import "creature_parts.ttrpg";
import "condition.ttrpg";
import "damage.ttrpg";

enum ECreatureSize {
    Tiny,
    Small,
    Medium,
    Large,
    Huge,
    Gargantuan,
}

enum ESpellSlotRank {
    Rank1,
    Rank2,
    Rank3,
    Rank4,
    Rank5,
    Rank6,
    Rank7,
    Rank8,
    Rank9,
    Rank10,
}

class TCreatureData {
    int Level;
    ECreatureSize Size;
    TRace Race;
    TClass Class;
    TAbilityScores Characteristic;
    int Movement = 0;
    BoundedQuantity Hitpoints = Race.Hitpoints + Level * (Class.Hitpoints + Characteristic.Constitution.Modifier);
    TArmor Armor;
    collection<TWeapon> Weapons;
    collection<TWeapon> NaturalWeapons;
    set<TCondition> Conditions;
    set<EDamageType> Immunities;
    map<EDamageType, int> Resistances;
    map<EDamageType, int> Vulnerabilities;
    Resource Actions = 0;
    Resource Reactions = 0;
    Resource Hands = 0;
    map<ESpellSlotRank, Resource> SpellSlots;
}
