import "armor.ttrpg";
import "weapon.ttrpg";
import "creature_parts.ttrpg";
import "condition.ttrpg";
import "damage.ttrpg";

enum ECreatureSize {
    Tiny,
    Small,
    Medium,
    Large,
    Huge,
    Gargantuan,
}

class TCreatureData {
    int Level;
    ECreatureSize Size;
    TRace Race;
    TClass Class;
    TAbilityScores Characteristic;
    int Movement = 0;
    BoundedQuantity Hitpoints = Race.Hitpoints + Level * (Class.Hitpoints + Characteristic.Constitution.Modifier);
    TArmor Armor;
    collection<TWeapon> Weapons;
    collection<TWeapon> NaturalWeapons;
    set<TCondition> Conditions;
    set<EDamageType> Immunities;
    map<EDamageType, int> Resistances;
    map<EDamageType, int> Vulnerabilities;
}
