enum ECharacteristic {
    Strength,
    Dexterity,
    Constitution,
    Intelligence,
    Wisdom,
    Charisma,
}

class TRace {
    string Name;
    int Hitpoints;
    collection<Feature> Features;
    grant @self.Features;
}

class TClass {
    string Name;
    int Hitpoints;
    collection<Feature> Features;
    grant @self.Features;
}

class TAbilityScore {
    int Value;
    derive int Modifier = Value / 2 - 5;
}

class TAbilityScores {
    TAbilityScore Strength;
    TAbilityScore Dexterity;
    TAbilityScore Constitution;
    TAbilityScore Intelligence;
    TAbilityScore Wisdom;
    TAbilityScore Charisma;
}
