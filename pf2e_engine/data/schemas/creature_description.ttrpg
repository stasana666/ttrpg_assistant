enum ECreatureTrait {
    Human,
    Humanoid,
    Animal,
}

enum ESenseKind {
    Vision,
    LowLightVision,
    Darkvision,
    Scent,
    Other,
}

enum ESensePrecision {
    Precise,
    Imprecise,
    Vague,
}

class TLanguage {
    string Name;
}

class TSense {
    ESenseKind Kind = Vision;
    string Name = "";
    int RangeFeet = 0;
    ESensePrecision Precision = Precise;
}
