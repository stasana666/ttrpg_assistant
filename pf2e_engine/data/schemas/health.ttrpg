import "hitpoints.ttrpg";
import "damage.ttrpg";

enum EZeroHpRule {
    Defeat,
    Dying,
    Death,
}

class TDamageContext {
    bool Critical = false;
    bool Nonlethal = false;
}

class THealthDamageResult {
    TDamageResult Hitpoints;
    bool NewlyKnockedOut = false;
    bool NewlyDead = false;
}

class TPendingAttackDamage {
    int Amount = 0;
    EDamageType Type;
    TDamageContext Context;

    query bool IsPhysical() {
        return @self.Type == Bludgeoning || @self.Type == Piercing || @self.Type == Slashing;
    }
}
