import "creature.ttrpg";
import "combat_checks.ttrpg";

action AttackWithWeapon;
action Stride;
action Demoralize;
action Trip;
action Stand;
action Fireball;
reaction AttackOfOpportunity;

class TStrikeDamageDice {
    int Count = 0;
    int Size = 4;
}

event TStrikeDamageDice StrikeDamageBonus for TCreature(TCreature Target, TWeapon Weapon);

action Strike for TCreature using TWeapon Weapon {
    cost @self.Actions = 1;
    choose TCreature Target where Target != @self && Target.IsAlive()
        && grid_distance(@self, Target) <= Weapon.Reach
        && has_line_of_effect(@self, Target);
    ResolveMeleeStrike(Weapon, Target, 0, 1, true);
}

action UseViciousSwing for TCreature {
    cost @self.Actions = 2;
    cost @self.Flourishes = 1;
    choose TCreature Target where Target != @self && Target.IsAlive()
        && grid_distance(@self, Target) <= @self.MaxWeaponReach()
        && has_line_of_effect(@self, Target);
    choose TWeapon Weapon from sources(@self.Weapons, @self.NaturalWeapons)
        where Weapon.Reach > 0 && grid_distance(@self, Target) <= Weapon.Reach;
    let ExtraDice = 1;
    if (@self.Level >= 18) {
        ExtraDice = 3;
    } else {
        if (@self.Level >= 10) {
            ExtraDice = 2;
        }
    }
    ResolveMeleeStrike(Weapon, Target, ExtraDice, 2, true);
}

feature ViciousSwing {
    grant UseViciousSwing;
}

activity ECheckOutcome ResolveMeleeStrike for TCreature(
    TWeapon Weapon, TCreature Target, int ExtraWeaponDice, int AttackCount, bool ApplyMAP
) {
    require ExtraWeaponDice >= 0 && AttackCount >= 0;
    require Target != @self && Target.IsAlive()
        && grid_distance(@self, Target) <= Weapon.Reach
        && has_line_of_effect(@self, Target);
    let Checks = TCheckRules {};
    let AttackBonus = @self.AttackBonus(Weapon);
    if (ApplyMAP) {
        AttackBonus -= @self.MultipleAttackPenalty(Weapon);
    }
    let Natural = roll(1, 20);
    let Outcome = Checks.Resolve(Natural, AttackBonus, Target.ArmorClass());
    if (AttackCount > 0) {
        @self.RecordAttack(AttackCount);
    }
    if (Outcome == Success || Outcome == CriticalSuccess) {
        let Size = Weapon.BaseDiceSize;
        if (Outcome == CriticalSuccess && Weapon.Traits.has(Fatal)) {
            Size = Weapon.DieFaces(Weapon.Traits.get(Fatal, { Die = D6; }).Die);
        }
        let Amount = roll(Weapon.DamageDiceCount + ExtraWeaponDice, Size);
        Amount += @self.DamageModifier(Weapon);
        for Bonus in StrikeDamageBonus(@self, Target, Weapon) {
            if (Bonus.Count > 0) {
                Amount += roll(Bonus.Count, Bonus.Size);
            }
        }
        Amount = Checks.MinimumDamage(Amount);
        if (Outcome == CriticalSuccess) {
            Amount = Amount * 2;
            if (Weapon.Traits.has(Fatal)) {
                let Extra = roll(1, Size);
                Amount += Extra;
            }
            if (Weapon.Traits.has(Deadly)) {
                let DeadlySize = Weapon.DieFaces(Weapon.Traits.get(Deadly, { Die = D6; }).Die);
                let Extra = roll(1, DeadlySize);
                Amount += Extra;
            }
        }
        Target.ReceiveDamage(Weapon.DamageType, Amount);
    }
    return Outcome;
}

feature PackAttack {
    on StrikeDamageBonus {
        let Allies = 0;
        for Ally in entities(TCreature) {
            if (Ally != @self && Ally != Target && Ally.IsAlive()
                && same_team(@self, Ally)
                && grid_distance(Ally, Target) <= Ally.MaxWeaponReach()
                && has_line_of_effect(Ally, Target)) {
                Allies += 1;
            }
        }
        if (Allies >= 2) {
            return TStrikeDamageDice { Count = 1; };
        }
        return TStrikeDamageDice {};
    }
}

feature HumanWarriorActions {
    grant AttackWithWeapon;
    grant Demoralize;
    grant Stride;
    grant Trip;
    grant Stand;
}

feature WolfActions {
    grant AttackWithWeapon;
    grant Stride;
}

feature WeaponStrike {
    grant Strike;
}

feature FighterReaction {
    grant AttackOfOpportunity;
}
